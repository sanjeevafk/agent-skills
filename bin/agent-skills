#!/usr/bin/env python3
"""
agent-skills: High-speed indexer and query router for the agent-skills cold-storage warehouse.
Provides sub-5ms search and retrieval across 2,000+ domain skills using SQLite FTS5.
"""

import os
import sys
import re
import time
import json
import sqlite3
import argparse
from pathlib import Path

WAREHOUSE_DIR = os.environ.get("AGENT_SKILLS_DIR", "/home/sanjeev/Downloads/agent-skills")
CACHE_DIR = os.path.expanduser("~/.cache/agent-skills")
DB_PATH = os.path.join(CACHE_DIR, "skills_index.db")

def parse_frontmatter(content: str):
    name = ""
    description = ""
    metadata = {}
    
    fm_match = re.match(r"^---\s*\n(.*?)\n---\s*\n", content, re.DOTALL)
    if fm_match:
        fm_text = fm_match.group(1)
        # Parse name
        name_m = re.search(r"^name:\s*['\"]?(.*?)['\"]?\s*$", fm_text, re.MULTILINE)
        if name_m:
            name = name_m.group(1).strip()
            
        # Parse description (single or multiline >-, |)
        desc_m = re.search(r"^description:\s*(?:[>|]-?\s*\n)?(.*?)(?=\n[a-zA-Z0-9_-]+:|\Z)", fm_text, re.MULTILINE | re.DOTALL)
        if desc_m:
            description = desc_m.group(1).replace("\n", " ").strip()
            description = re.sub(r"\s+", " ", description)
            
    # Fallback to H1 heading if name is missing
    if not name:
        h1_m = re.search(r"^#\s+(.+)$", content, re.MULTILINE)
        if h1_m:
            name = h1_m.group(1).strip()
            
    # Fallback description if missing
    if not description:
        # Find first non-empty paragraph after headings
        lines = [line.strip() for line in content.splitlines() if line.strip() and not line.strip().startswith(("#", "---"))]
        if lines:
            description = lines[0][:200]
            
    return name, description

def init_db(db_path: str):
    os.makedirs(os.path.dirname(db_path), exist_ok=True)
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()
    cur.execute("PRAGMA table_info(skills)")
    cols = [r[1] for r in cur.fetchall()]
    if cols and "is_canonical" not in cols:
        cur.execute("DROP TABLE IF EXISTS skills;")
        cur.execute("DROP TABLE IF EXISTS skills_fts;")
    cur.execute("""
        CREATE TABLE IF NOT EXISTS meta (
            key TEXT PRIMARY KEY,
            value TEXT
        );
    """)
    cur.execute("""
        CREATE TABLE IF NOT EXISTS skills (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT UNIQUE,
            collection TEXT,
            tier TEXT,
            is_canonical INTEGER DEFAULT 0,
            description TEXT,
            path TEXT,
            mtime REAL
        );
    """)
    cur.execute("""
        CREATE VIRTUAL TABLE IF NOT EXISTS skills_fts USING fts5(
            name,
            collection,
            description,
            path,
            content='skills',
            content_rowid='id'
        );
    """)
    conn.commit()
    return conn

def build_index(force: bool = False):
    conn = init_db(DB_PATH)
    cur = conn.cursor()
    
    # Check warehouse mtime
    cur.execute("SELECT value FROM meta WHERE key='last_indexed'")
    row = cur.fetchone()
    last_indexed = float(row[0]) if row else 0.0
    
    if not force and last_indexed > 0:
        warehouse_mtime = os.path.getmtime(WAREHOUSE_DIR)
        if warehouse_mtime <= last_indexed:
            conn.close()
            return
            
    t0 = time.time()
    cur.execute("DELETE FROM skills;")
    cur.execute("DELETE FROM skills_fts;")
    
    # Identify canonical skills
    canonical_dir = os.path.join(WAREHOUSE_DIR, "canonical")
    canonical_names = set()
    if os.path.isdir(canonical_dir):
        canonical_names = set(os.listdir(canonical_dir))

    records = []
    
    for root, dirs, files in os.walk(WAREHOUSE_DIR):
        dirs[:] = [d for d in dirs if not d.startswith((".", "node_modules", "target", "venv", ".venv"))]
        
        if "SKILL.md" in files:
            skill_path = os.path.join(root, "SKILL.md")
            mtime = os.path.getmtime(skill_path)
            rel_dir = os.path.relpath(root, WAREHOUSE_DIR)
            
            parts = rel_dir.split(os.sep)
            if parts[0] == "canonical":
                tier = "canonical"
                collection = "canonical"
                default_name = parts[1] if len(parts) > 1 else "canonical"
            elif parts[0] == "collections":
                tier = "collection"
                collection = parts[1] if len(parts) > 1 else "root"
                default_name = parts[-1]
            elif parts[0] == "skills":
                tier = "modular"
                collection = "skills"
                default_name = parts[1] if len(parts) > 1 else "skills"
            else:
                tier = "other"
                collection = parts[0]
                default_name = parts[-1]
                
            try:
                with open(skill_path, "r", encoding="utf-8", errors="replace") as fp:
                    content = fp.read()
                name, description = parse_frontmatter(content)
                if not name:
                    name = default_name
                    
                is_canonical = 1 if (name in canonical_names or default_name in canonical_names) else 0
                records.append((name, collection, tier, is_canonical, description, skill_path, mtime))
            except Exception:
                continue
                
    tier_priority = {"canonical": 1, "collection": 2, "modular": 3, "other": 4}
    records.sort(key=lambda r: (tier_priority.get(r[2], 99), r[0]))
    
    seen_names = set()
    deduped = []
    for r in records:
        name_key = r[0].lower()
        if name_key not in seen_names:
            seen_names.add(name_key)
            deduped.append(r)
            
    cur.executemany("""
        INSERT INTO skills (name, collection, tier, is_canonical, description, path, mtime)
        VALUES (?, ?, ?, ?, ?, ?, ?);
    """, deduped)
    
    cur.execute("""
        INSERT INTO skills_fts(skills_fts) VALUES('rebuild');
    """)
    
    cur.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('last_indexed', ?);", (str(time.time()),))
    conn.commit()
    conn.close()
    elapsed = (time.time() - t0) * 1000
    return len(deduped), elapsed

def search_skills(query: str, limit: int = 10):
    if not os.path.exists(DB_PATH):
        build_index(force=True)
        
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    
    clean_query = re.sub(r"[^\w\s-]", " ", query).strip()
    tokens = [t.strip() for t in clean_query.split() if t.strip()]
    if not tokens:
        conn.close()
        return [], 0.0
        
    fts_expr = " OR ".join([f'"{t}"*' for t in tokens])
    
    t0 = time.time()
    try:
        cur.execute(f"""
            SELECT s.name, s.collection, s.tier, s.is_canonical, s.description, s.path, bm25(skills_fts) as rank
            FROM skills_fts f
            JOIN skills s ON f.rowid = s.id
            WHERE skills_fts MATCH ?
            ORDER BY rank
            LIMIT ?;
        """, (fts_expr, limit))
        rows = cur.fetchall()
    except Exception:
        like_cond = "%" + "%".join(tokens) + "%"
        cur.execute("""
            SELECT name, collection, tier, is_canonical, description, path, 0 as rank
            FROM skills
            WHERE name LIKE ? OR description LIKE ? OR collection LIKE ?
            LIMIT ?;
        """, (like_cond, like_cond, like_cond, limit))
        rows = cur.fetchall()
        
    elapsed = (time.time() - t0) * 1000
    conn.close()
    
    results = []
    for r in rows:
        results.append({
            "name": r[0],
            "collection": r[1],
            "tier": r[2],
            "is_canonical": bool(r[3]),
            "description": r[4],
            "path": r[5],
            "score": r[6]
        })
    return results, elapsed

def cmd_find(args):
    query = " ".join(args.query)
    results, elapsed = search_skills(query, limit=args.limit)
    
    if args.json:
        print(json.dumps({"query": query, "elapsed_ms": round(elapsed, 2), "count": len(results), "results": results}, indent=2))
        return
        
    if not results:
        print(f"No skills found matching '{query}'. Run 'agent-skills index --force' to refresh.")
        sys.exit(1)
        
    print(f"\nFound {len(results)} matches for '{query}' in {elapsed:.2f} ms:\n")
    print(f"{'STATUS':<12} {'SKILL NAME':<32} {'COLLECTION':<22} {'DESCRIPTION'}")
    print("-" * 102)
    for res in results:
        status = "[ACTIVE]" if res['is_canonical'] else "[COLD]"
        desc = (res['description'][:40] + "...") if len(res['description']) > 42 else res['description']
        print(f"{status:<12} {res['name']:<32} {res['collection']:<22} {desc}")
    print("\nTo inspect a skill:")
    print(f"  agent-skills show {results[0]['name']}\n")

def cmd_show(args):
    name_or_query = args.skill.strip()
    
    if not os.path.exists(DB_PATH):
        build_index()
        
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    
    # Exact match first
    cur.execute("SELECT name, collection, description, path FROM skills WHERE lower(name) = lower(?)", (name_or_query,))
    row = cur.fetchone()
    
    if not row:
        # Prefix match
        cur.execute("SELECT name, collection, description, path FROM skills WHERE lower(name) LIKE lower(?) LIMIT 1", (f"{name_or_query}%",))
        row = cur.fetchone()
        
    conn.close()
    
    if not row:
        print(f"Error: Skill '{name_or_query}' not found. Run 'agent-skills find {name_or_query}' to search.", file=sys.stderr)
        sys.exit(1)
        
    name, col, desc, path = row
    
    if args.path_only:
        print(path)
        return
        
    if not os.path.exists(path):
        print(f"Error: Target file does not exist at {path}", file=sys.stderr)
        sys.exit(1)
        
    with open(path, "r", encoding="utf-8", errors="replace") as fp:
        content = fp.read()
        
    if args.header:
        print(f"Path: {path}\nCollection: {col}\nName: {name}\n")
    print(content)

def cmd_list(args):
    if not os.path.exists(DB_PATH):
        build_index()
        
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    
    if args.collection:
        cur.execute("SELECT name, description, path FROM skills WHERE collection = ? ORDER BY name", (args.collection,))
        rows = cur.fetchall()
        print(f"\nSkills in collection '{args.collection}' ({len(rows)} total):\n")
        for r in rows:
            print(f"  • {r[0]:<30} {r[1][:60]}")
    else:
        cur.execute("SELECT collection, COUNT(*) FROM skills GROUP BY collection ORDER BY COUNT(*) DESC")
        rows = cur.fetchall()
        print(f"\nWarehouse Collections ({len(rows)} collections):\n")
        for r in rows:
            print(f"  • {r[0]:<32} ({r[1]} skills)")
            
    conn.close()

def cmd_stats(args):
    if not os.path.exists(DB_PATH):
        build_index()
        
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("SELECT count(*) FROM skills")
    total_skills = cur.fetchone()[0]
    
    cur.execute("SELECT count(*) FROM skills WHERE is_canonical = 1")
    canonical_count = cur.fetchone()[0]
    
    cur.execute("SELECT count(DISTINCT collection) FROM skills WHERE collection != 'skills' AND collection != 'canonical'")
    collections_count = cur.fetchone()[0]
    
    cur.execute("SELECT value FROM meta WHERE key='last_indexed'")
    last_indexed = float(cur.fetchone()[0])
    conn.close()
    
    db_size_kb = os.path.getsize(DB_PATH) / 1024
    
    print("\nAgent Skills Warehouse Index Statistics:")
    print(f"  • Total Unique Skills:    {total_skills}")
    print(f"  • Active Canonical Tier:  {canonical_count} skills (in active runtime)")
    print(f"  • Cold Storage Warehouse: {total_skills - canonical_count} skills across {collections_count} domain collections")
    print(f"  • Index Database Size:    {db_size_kb:.1f} KB ({DB_PATH})")
    print(f"  • Last Indexed At:        {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(last_indexed))}\n")

def cmd_index(args):
    res = build_index(force=args.force)
    if res:
        count, elapsed = res
        print(f"Successfully indexed {count} skills in {elapsed:.2f} ms into {DB_PATH}.")
    else:
        print("Index is already up to date. Use --force to rebuild.")

def main():
    parser = argparse.ArgumentParser(description="Agent Skills Warehouse Router")
    subparsers = parser.add_subparsers(dest="subcommand", help="Command to run")
    
    # find
    p_find = subparsers.add_parser("find", help="Find skills by keyword query")
    p_find.add_argument("query", nargs="+", help="Search query keywords")
    p_find.add_argument("-n", "--limit", type=int, default=8, help="Max results (default: 8)")
    p_find.add_argument("--json", action="store_true", help="Output JSON")
    
    # show
    p_show = subparsers.add_parser("show", help="Show full content or path of a skill")
    p_show.add_argument("skill", help="Skill name")
    p_show.add_argument("-p", "--path-only", action="store_true", help="Print only the absolute file path")
    p_show.add_argument("--header", action="store_true", help="Print header metadata before content")
    
    # list
    p_list = subparsers.add_parser("list", help="List collections or skills in a collection")
    p_list.add_argument("collection", nargs="?", help="Specific collection name")
    
    # stats
    subparsers.add_parser("stats", help="Display warehouse index statistics")
    
    # index
    p_index = subparsers.add_parser("index", help="Rebuild the SQLite FTS5 index")
    p_index.add_argument("-f", "--force", action="store_true", help="Force rebuild")
    
    args = parser.parse_args()
    if not args.subcommand:
        parser.print_help()
        sys.exit(1)
        
    if args.subcommand == "find":
        cmd_find(args)
    elif args.subcommand == "show":
        cmd_show(args)
    elif args.subcommand == "list":
        cmd_list(args)
    elif args.subcommand == "stats":
        cmd_stats(args)
    elif args.subcommand == "index":
        cmd_index(args)

if __name__ == "__main__":
    main()
